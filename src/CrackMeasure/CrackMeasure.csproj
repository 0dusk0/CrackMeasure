<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrackMeasure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="MiniExcel" Version="1.47.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\models\crack_seg.onnx" Link="crack_seg.onnx" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\models\crack_seg.onnx')" />
  </ItemGroup>

</Project>